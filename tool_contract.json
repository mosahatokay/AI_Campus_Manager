
{
  "name": "find_rooms",
  "description": "Search for available college rooms based on date, capacity, computers, projector and optional time range. This tool only reads data and does not create reservations.",

  "input_schema": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string",
        "format": "date",
        "description": "Requested date in YYYY-MM-DD format"
      },
      "min_capacity": {
        "type": "integer",
        "minimum": 1,
        "description": "Minimum number of student seats required"
      },
      "min_computers": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Minimum number of computers required"
      },
      "require_projector": {
        "type": "boolean",
        "description": "Whether a projector is required"
      },
      "start_time": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "description": "Optional start time in HH:MM format"
      },
      "end_time": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "description": "Optional end time in HH:MM format"
      }
    },
    "required": [
      "date",
      "min_capacity",
      "require_projector"
    ],
    "dependentRequired": {
      "start_time": ["end_time"],
      "end_time": ["start_time"]
    },
    "additionalProperties": false
  },

  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["ok", "error"]
      },
      "data": {
        "type": "object",
        "properties": {
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "RoomID": {"type": "integer"},
                "BuildingID": {"type": "integer"},
                "FloorNumber": {"type": "integer"},
                "RoomNumber": {"type": "integer"},
                "Capacity": {"type": "integer"},
                "ComputerCount": {"type": "integer"},
                "HasProjector": {"type": "boolean"},
                "available_slots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "start": {"type": "string"},
                      "end": {"type": "string"}
                    },
                    "required": ["start", "end"]
                  }
                }
              }
            }
          }
        },
        "required": ["rooms"]
      },
      "error": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "message": {"type": "string"},
          "retryable": {"type": "boolean"}
        },
        "required": ["type", "message", "retryable"]
      }
    },
    "required": ["status"]
  },

  "permissions": {
    "read_only": true,
    "requires_confirmation": false
  },

  "business_rules": {
    "working_days": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday"],
    "opening_time": "08:00",
    "closing_time": "22:00",
    "capacity_priority": "smallest_sufficient",
    "computer_priority": "smallest_sufficient",
    "missing_time": "show_all_available_slots",
    "missing_projector": "ask_user",
    "no_results": "report_and_ask_user"
  }
}
