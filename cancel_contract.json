{
  "name": "cancel_reservation",
  "description": "Cancel an existing reservation by ID after explicit secretary confirmation. In this version cancellation permanently deletes the row in the existing dbo.Reservations table.",
  "type": "write",
  "requires_approval": true,
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "reservation_id": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "reservation_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "const": "ok"
          },
          "data": {
            "type": "object",
            "properties": {
              "reservation_id": {
                "type": "integer",
                "minimum": 1
              },
              "room_id": {
                "type": "integer",
                "minimum": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "start_time": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end_time": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            },
            "required": [
              "reservation_id",
              "room_id",
              "date",
              "start_time",
              "end_time"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "data"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "const": "error"
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "permissions": {
    "read_only": false,
    "requires_confirmation": true,
    "approval_source": "trusted_application_state_not_model_arguments"
  },
  "business_rules": {
    "cancel_only_existing_reservation": true,
    "second_cancellation_returns_reservation_not_found": true,
    "delete_atomically_and_return_deleted_booking": true,
    "automatic_write_retry": false,
    "cancellation_mode": "hard_delete_in_current_schema",
    "confirmation_must_identify_exact_reservation": true
  }
}
